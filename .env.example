# Copie ce fichier en ".env" pour le dev local (ne sera pas committé).
# Sur Vercel, ajoute ces variables dans Settings → Environment Variables.

# Ta clé API Anthropic (https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optionnel : modèle utilisé pour l'analyse photo.
# Par défaut claude-opus-4-8 (le plus capable).
# Mets claude-sonnet-4-6 pour réduire le coût.
# ANTHROPIC_MODEL=claude-opus-4-8
